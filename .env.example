# Copy to .env for local development. Never commit .env; it is excluded from git, Docker and releases.
# --- LLM (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Judge should differ from the generator to reduce self-preference bias.
JUDGE_MODEL=gpt-4o
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_CACHE_ENABLED=true
# --- API security ---
# Required unless SSA_DEV_MODE=1. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
STUDENT_ASSISTANT_API_KEY=
SSA_DEV_MODE=0
ALLOWED_ORIGINS=
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=524288
# --- Modelling ---
CUTOFF_FRACTION=0.40   # default checkpoint
MODEL_ENGINE=auto
INCLUDE_SENSITIVE_FEATURES=false
ENABLE_TEXT_EMBEDDINGS=true
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
STUDENT_ASSISTANT_ADMIN_KEY=
# Share of live analyses / copilot answers / briefings reviewed by the LLM judge in the background (0 = off)
ONLINE_EVAL_SAMPLE_RATE=0.1
LLM_PRICE_PROMPT_PER_1K=0.00015
LLM_PRICE_COMPLETION_PER_1K=0.0006
# Course checkpoints to build (share of planned course length)
CHECKPOINTS=0.15,0.25,0.40,0.60
