# Copy to .env for local development. Never commit .env; it is excluded from git, Docker and releases.
# --- LLM (Claude via the Anthropic API) ---
# Master switch: false = no LLM request is ever sent, whatever keys are set (every feature uses its computed fallback).
LLM_ENABLED=true
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Models per feature tier. The judge must differ from both generators (the service refuses to start otherwise).
CLAUDE_MODEL_FAST=claude-haiku-5-5     # search understanding, outreach rewrites, advisor-note themes
CLAUDE_MODEL_MAIN=claude-sonnet-5-5    # support-plan agents, copilot, precedent synthesis, cohort briefing
CLAUDE_MODEL_JUDGE=claude-opus-5-5     # judge, pairwise A/B, DeepEval wrapper
# output_config.effort per tier (low | medium | high | xhigh | max). Thinking is adaptive and always on for these models.
CLAUDE_EFFORT_FAST=low
CLAUDE_EFFORT_MAIN=medium
CLAUDE_EFFORT_JUDGE=high
CLAUDE_MAX_TOKENS=8000
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=2
LLM_CACHE_ENABLED=true
# Cost estimates use a per-model price table in USD per million tokens. Defaults (Anthropic pricing page, 2026-10-11):
#   claude-opus-5-5   input 4.00, 5-min cache write 5.00, cache read 0.20, output 20.00
#   claude-sonnet-5-5 input 2.00, 5-min cache write 2.50, cache read 0.10, output 10.00
#   claude-haiku-5-5  input 0.10, 5-min cache write 0.125, cache read 0.01, output 0.50 (prompts <= 100K tokens;
#                     over 100K: 0.50 / 0.625 / 0.05 / 2.50)
# Override or add models with a JSON object of the same shape, e.g.
# LLM_PRICE_TABLE={"claude-sonnet-5-5": {"input": 2.0, "cache_write": 2.5, "cache_read": 0.1, "output": 10.0}}
LLM_PRICE_TABLE=
# Optional alternative provider (LLM_PROVIDER=openai): OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL, JUDGE_MODEL.
# --- API security ---
# Required unless SSA_DEV_MODE=1. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
STUDENT_ASSISTANT_API_KEY=
SSA_DEV_MODE=0
ALLOWED_ORIGINS=
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_PER_MINUTE=120
# 0 = no limit in the app (the gateway enforces it)
# Several uvicorn workers on one host: WEB_CONCURRENCY=4 and SHARED_STATE=sqlite (jobs, rate limits, recent analyses)
WEB_CONCURRENCY=1
SHARED_STATE=memory
MAX_REQUEST_BYTES=524288
# --- Modelling ---
CUTOFF_FRACTION=0.40   # default checkpoint
MODEL_ENGINE=auto
INCLUDE_SENSITIVE_FEATURES=false
ENABLE_TEXT_EMBEDDINGS=true
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
STUDENT_ASSISTANT_ADMIN_KEY=
# Share of live analyses / copilot answers / briefings reviewed by the LLM judge in the background (0 = off)
ONLINE_EVAL_SAMPLE_RATE=0.1
# Course checkpoints to build (share of planned course length)
CHECKPOINTS=0.15,0.25,0.40,0.60
